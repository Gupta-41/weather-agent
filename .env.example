# Required for /api/chat. Everything else works without it.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
MAX_AGENT_STEPS=6

# Comma-separated. Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173

DATABASE_PATH=data/weather.db

# Background alert polling over saved locations.
ALERTS_ENABLED=true
ALERT_POLL_MINUTES=30
ALERT_LOOKAHEAD_DAYS=5

DEFAULT_LANGUAGE=en

# --- LLM provider -----------------------------------------------------------
# "anthropic" (needs payment) or "gemini" (free tier, no card). Either works —
# the agent, trace and UI don't change. See README for how to get a Gemini key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash
